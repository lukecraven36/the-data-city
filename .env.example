# Placeholders only. Login prompts securely; passwords are not retained.
# This app does not automatically load .env files.
TDC_ACCOUNT_EMAIL=YOUR_WORK_EMAIL
# Optional external secret-store token, never a frontend variable.
TDC_ACCESS_TOKEN=YOUR_SERVER_SIDE_TOKEN
# Optional absolute path to the EXISTING private state directory (never a new ledger).
# Alternatively put that path in ignored .openai/local/private-directory.txt.
# TDC_PRIVATE_DIR=C:\path\outside-OneDrive\existing-project\.private
